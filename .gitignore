# Ensure source and important files are tracked
# (Assuming your source code is under src/)
!src/
!src/**/
!src/**/CMakeLists.txt
!src/**/package.xml
!src/**/*.msg
!src/**/*.srv
!src/**/*.action
!src/**/*.cpp
!src/**/*.hpp
!src/**/*.py
!src/**/*.yaml
!src/**/*.launch.py
